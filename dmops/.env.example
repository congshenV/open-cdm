# dmops 本地开发环境变量样例。
# 复制成 .env 后由 `make run` 自动加载（.env 已在 .gitignore 中）。
# 正式部署通过部署平台注入，不要把这些值提交到仓库。

# 服务监听
DMOPS_HOST=0.0.0.0
DMOPS_PORT=8080
DMOPS_DEBUG=false
DMOPS_LOG_LEVEL=INFO

# 与 CloudDM console 的 dmops.proxy.identity.secret 必须完全一致。
# 生成方式：openssl rand -hex 32
DMOPS_IDENTITY_SECRET=

# 仅当绕过 console 直连调试时设为 false。
DMOPS_IDENTITY_VERIFY_ENABLED=true

# 配置管理里 is_encrypt=true 的配置项用的 AES-256 加密密钥（32 字节）。
# 生成方式：openssl rand -hex 16。与 DMOPS_IDENTITY_SECRET 用不同的值。
DMOPS_CONFIG_ENCRYPT_SECRET=

# 复用 CloudDM 的 MySQL。正式部署由部署平台注入。
DMOPS_DB_HOST=127.0.0.1
DMOPS_DB_PORT=13307
DMOPS_DB_NAME=cdmgr
DMOPS_DB_USER=root
DMOPS_DB_PASSWORD=
DMOPS_DB_CHARSET=utf8mb4

# 阿里云 OpenAPI 调用参数。
DMOPS_ALIYUN_READ_TIMEOUT_MS=30000
DMOPS_ALIYUN_CONNECT_TIMEOUT_MS=10000
DMOPS_ALIYUN_SYNC_WORKERS=4
DMOPS_ALIYUN_MAX_INSTANCES_PER_REGION=5000

# CloudDM console 出向调用（注册数据源 JWT 透传 + 数据校验 syncQuery AK/SK）。
# 本地单机模式默认即可；容器/集群部署改为 console 服务地址（如 http://dm_console:8222）。
DMOPS_CDM_CONSOLE_URL=http://127.0.0.1:8222
# 注册数据源落位的环境 ID 与集群 ID（addDs 参数，与 console 环境列表对应）。
DMOPS_CDM_ENV_ID=1
DMOPS_CDM_CLUSTER_ID=2
